{
  "name": "fullstack-bot",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/app.js",
    "dev": "tsx --env-file=.env watch src/app.ts",
    "telegram:webhook:set": "tsx --env-file=.env scripts/set-telegram-webhook.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "dependencies": {
    "fastify": "5.12.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
