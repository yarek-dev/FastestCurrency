@startuml Fullstack Bot - Containers
!include <C4/C4_Container>

title Container diagram for Fullstack Bot

LAYOUT_LEFT_RIGHT()

Person(user, "Пользователь", "Конвертирует валюты и криптовалюты и выбирает период изменения курса в личном чате Telegram.")

System_Ext(telegram, "Telegram Bot API", "Доставляет обновления боту и выполняет команду из webhook-ответа.")
System_Ext(currency_beacon, "CurrencyBeacon API", "Предоставляет текущие и исторические курсы фиатных валют и криптовалют.")
System_Ext(frankfurter, "Frankfurter API", "Предоставляет текущие и исторические справочные курсы фиатных валют.")

System_Boundary(fullstack_bot, "Fullstack Bot") {
  Container(edge_function, "telegram-webhook", "Supabase Edge Functions, Deno 2, TypeScript", "Принимает сообщения и callback query, получает курсы и возвращает пользователю результаты.")
}

Rel(user, edge_function, "Запрашивает конвертацию, выбирает период и получает ответы", "Личный чат Telegram")
Rel(telegram, edge_function, "Передаёт message или callback_query; получает sendMessage в HTTP-ответе", "HTTPS/JSON")
Rel(edge_function, telegram, "Подтверждает нажатие кнопки", "answerCallbackQuery, HTTPS/JSON")
Rel(edge_function, currency_beacon, "Запрашивает текущие и исторические курсы", "HTTPS/JSON, Bearer token")
Rel(edge_function, frankfurter, "Запрашивает справочные курсы фиатных валют", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
