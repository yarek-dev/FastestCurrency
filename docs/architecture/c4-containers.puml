@startuml Fullstack Bot - Containers
!include <C4/C4_Container>

title Container diagram for Fullstack Bot

LAYOUT_LEFT_RIGHT()

Person(user, "Пользователь", "Конвертирует валюты и криптовалюты и выбирает период изменения курса в личном чате Telegram.")

System_Ext(telegram, "Telegram Bot API", "Доставляет обновления боту и выполняет команду из webhook-ответа.")
System_Ext(currency_beacon, "CurrencyBeacon API", "Предоставляет текущие и исторические курсы фиатных валют и криптовалют.")
System_Ext(frankfurter, "Frankfurter API", "Предоставляет текущие и исторические справочные курсы фиатных валют.")

System_Boundary(fullstack_bot, "Fullstack Bot") {
  Container(bot_app, "Bot Application", "Node.js 24, TypeScript 5, Fastify 5", "Принимает сообщения и callback query, получает курсы, рассчитывает конвертацию и изменение за выбранный период и возвращает отдельные сообщения.")
}

Rel(user, bot_app, "Отправляет запросы на конвертацию и получает ответы", "Telegram")
Rel(telegram, bot_app, "Передаёт message или callback_query; получает sendMessage в HTTP-ответе", "HTTPS/JSON")
Rel(bot_app, telegram, "Подтверждает нажатие кнопки", "answerCallbackQuery, HTTPS/JSON")
Rel(bot_app, currency_beacon, "Запрашивает текущий и исторический курсы или один курс выбранного периода", "HTTPS/JSON, Bearer token")
Rel(bot_app, frankfurter, "Запрашивает пару курсов для fallback или один курс выбранного периода", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
