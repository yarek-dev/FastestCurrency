Rel(user, fullstack_bot, "Запрашивает конвертацию и получает сумму, курс и изменение за день через Telegram")
Rel(fullstack_bot, telegram, "Использует как канал взаимодействия с пользователем")
Rel(fullstack_bot, currency_beacon, "Получает текущий и исторический курсы валют и криптовалют")
Rel(fullstack_bot, frankfurter, "Получает текущий и исторический курсы фиатных валют при отсутствии или сбое основного источника")

SHOW_LEGEND()
