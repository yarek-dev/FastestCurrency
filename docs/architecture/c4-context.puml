@startuml Fullstack Bot - System Context
!include <C4/C4_Context>

title System Context diagram for Fullstack Bot

LAYOUT_LEFT_RIGHT()

Person(user, "Пользователь", "Конвертирует валюты и криптовалюты и видит изменение курса к предыдущему дню в личном чате Telegram.")

System(fullstack_bot, "Fullstack Bot", "Конвертирует заданную сумму и сравнивает текущий курс с курсом предыдущего UTC-дня.")

System_Ext(telegram, "Telegram", "Предоставляет канал общения пользователя с ботом.")
System_Ext(currency_beacon, "CurrencyBeacon", "Предоставляет текущие и исторические курсы фиатных валют и криптовалют.")
