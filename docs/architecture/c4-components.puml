@startuml Fullstack Bot - Edge Function Components
!include <C4/C4_Component>

title Component diagram for Fullstack Bot — telegram-webhook

LAYOUT_TOP_DOWN()

System_Ext(telegram, "Telegram Bot API", "Доставляет сообщения и callback query, принимает webhook-ответ и подтверждение callback.")
System_Ext(currency_beacon, "CurrencyBeacon API", "Предоставляет текущие и исторические курсы фиатных валют и криптовалют.")
System_Ext(frankfurter, "Frankfurter API", "Предоставляет текущие и исторические справочные курсы фиатных валют.")

Container_Boundary(edge_function, "telegram-webhook Edge Function") {
  Component(http_interface, "HTTP Interface / Composition Root", "Deno Fetch API", "Проверяет метод, webhook secret и JSON; собирает зависимости и возвращает webhook action.")
  Component(update_router, "Telegram Update Router", "TypeScript", "Выбирает обработчик сообщения или callback query.")
  Component(message_handler, "Message Handler", "TypeScript", "Обрабатывает команды и конвертацию; формирует ответ и кнопки периода.")
  Component(callback_handler, "Callback Query Handler", "TypeScript", "Читает callback data и формирует отдельный ответ за период.")
  Component(convert_currency, "Convert Currency", "TypeScript", "Рассчитывает сумму и изменение относительно вчерашнего курса.")
  Component(period_change, "Get Period Change", "TypeScript", "Сравнивает исходный курс с историческим курсом выбранного провайдера.")
  Component(rate_pair, "Exchange Rate Pair / Fallback", "TypeScript", "Получает пару курсов у одного источника и при допустимом сбое переключается на резервный.")
  Component(beacon_adapter, "CurrencyBeacon Adapter", "TypeScript, Fetch API", "Получает и нормализует текущий или исторический курс.")
  Component(frankfurter_adapter, "Frankfurter Adapter", "TypeScript, Fetch API", "Получает и нормализует справочный курс.")
  Component(telegram_client, "Telegram Callback Client", "TypeScript, Fetch API", "Подтверждает callback query через Telegram Bot API.")
}

Rel(telegram, http_interface, "Передаёт message или callback_query; получает sendMessage в ответе", "HTTPS/JSON")
Rel(http_interface, update_router, "Передаёт update; получает webhook action", "HandleTelegramUpdate")
Rel(update_router, message_handler, "Передаёт message", "HandleTelegramMessage")
Rel(update_router, callback_handler, "Передаёт callback_query", "HandleTelegramCallbackQuery")
Rel(message_handler, convert_currency, "Передаёт сумму и валютную пару", "ConvertCurrency")
Rel(callback_handler, period_change, "Передаёт исходный курс, провайдера, период и дату", "GetPeriodChange")
Rel(callback_handler, telegram_client, "Запрашивает подтверждение нажатия", "AnswerCallbackQuery")
Rel(telegram_client, telegram, "Подтверждает callback", "answerCallbackQuery, HTTPS/JSON")
Rel(convert_currency, rate_pair, "Запрашивает текущий и вчерашний курсы", "GetExchangeRatePair")
Rel(rate_pair, beacon_adapter, "Получает пару у основного источника", "GetExchangeRate")
Rel(rate_pair, frankfurter_adapter, "Получает пару при fallback или без основного источника", "GetExchangeRate")
Rel(period_change, beacon_adapter, "Запрашивает один исторический курс", "GetExchangeRate")
Rel(period_change, frankfurter_adapter, "Запрашивает один исторический курс", "GetExchangeRate")
Rel(beacon_adapter, currency_beacon, "Получает текущий или исторический курс", "HTTPS/JSON, Bearer token")
Rel(frankfurter_adapter, frankfurter, "Получает текущий или исторический курс", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
