@startuml Fullstack Bot - Telegram Bot Service Components
!include <C4/C4_Component>

title Component diagram for Fullstack Bot — Bot Application

LAYOUT_TOP_DOWN()

System_Ext(telegram, "Telegram Bot API", "Доставляет сообщения и callback query, принимает webhook-ответ и подтверждение callback.")
System_Ext(currency_beacon, "CurrencyBeacon API", "Предоставляет текущие и исторические курсы фиатных валют и криптовалют.")
System_Ext(frankfurter, "Frankfurter API", "Предоставляет текущие и исторические справочные курсы фиатных валют.")

Container_Boundary(bot_app, "Bot Application") {
  Component(http_interface, "HTTP Interface", "Fastify 5", "Предоставляет GET /health и защищённый POST /telegram/webhook; проверяет схему Telegram update.")
  Component(update_processor, "Telegram Update Processor", "TypeScript 5", "Разбирает сообщения и callback data, формирует ответы и inline-кнопки, подтверждает нажатия.")
  Component(conversion_service, "Currency Conversion Service", "TypeScript 5", "Рассчитывает сумму и изменение за предыдущий день или выбранный период без хранения состояния.")
  Component(exchange_rate_integration, "Exchange Rate Integration", "TypeScript 5, Fetch API", "Получает пару текущего и исторического курсов с атомарным fallback либо один historical-курс выбранного провайдера.")
}

Rel(telegram, http_interface, "Передаёт message или callback_query; получает sendMessage в ответе", "HTTPS/JSON")
Rel(http_interface, update_processor, "Передаёт проверенный Telegram update", "HandleTelegramUpdate")
Rel(update_processor, telegram, "Подтверждает нажатие inline-кнопки", "answerCallbackQuery, HTTPS/JSON, timeout 3 s")
Rel(update_processor, conversion_service, "Запрашивает конвертацию или изменение за период", "ConvertCurrency / GetPeriodChange")
Rel(conversion_service, exchange_rate_integration, "Запрашивает пару курсов или один historical-курс", "GetExchangeRatePair / GetExchangeRate")
Rel(exchange_rate_integration, currency_beacon, "Параллельно запрашивает latest и historical; при ошибке отменяет связанный запрос", "HTTPS/JSON, Bearer token, timeout 3 s")
Rel(exchange_rate_integration, frankfurter, "Запрашивает оба курса напрямую или после сбоя пары запросов основного источника", "HTTPS/JSON, timeout 3 s")

SHOW_LEGEND()
@enduml
