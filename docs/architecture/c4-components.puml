@startuml Fullstack Bot - Edge Function Components
!include <C4/C4_Component>

title Component diagram for Fullstack Bot — telegram-webhook

LAYOUT_TOP_DOWN()

System_Ext(telegram, "Telegram Bot API", "Доставляет сообщения и принимает webhook-ответ.")
System_Ext(gemini, "Gemini API", "Создаёт эмбеддинги и формулирует ответы.")
ContainerDb(database, "Database", "Supabase PostgreSQL", "Хранит переписку, базу знаний и векторы.")

Container_Boundary(edge_function, "telegram-webhook Edge Function") {
  Component(http_interface, "Telegram Webhook Adapter", "Deno Fetch API", "Проверяет запрос, преобразует Telegram update и формирует webhook action.")
  Component(process_update, "Process Bot Message", "TypeScript", "Сохраняет входящее сообщение и отвечает, пока диалог не ведёт менеджер.")
  Component(message_repository, "Message Repository", "TypeScript, Supabase client", "Реализует порт сохранения сообщений через RPC.")
  Component(message_handler, "Reply to Question", "TypeScript", "Проверяет текст вопроса и подбирает ответ или сообщение об ошибке.")
  Component(knowledge_answer, "Answer Knowledge Question", "TypeScript", "Получает подходящие записи и формулирует ответ по ним.")
  Component(gemini_adapter, "Gemini Adapters", "TypeScript, Fetch API", "Векторизуют вопрос и генерируют ответ.")
  Component(bot_data, "Bot Data Adapter", "TypeScript, Supabase client", "Читает режим менеджера и ищет сведения в базе знаний.")
}

Rel(telegram, http_interface, "Передаёт сообщение и получает sendMessage в ответе", "HTTPS/JSON")
Rel(http_interface, process_update, "Передаёт сообщение и получает текст ответа", "ProcessBotMessage")
Rel(process_update, message_handler, "Обрабатывает сообщение после проверки режима менеджера")
Rel(process_update, bot_data, "Проверяет режим менеджера до и после генерации")
Rel(process_update, message_repository, "Сохраняет входящее сообщение и ответ", "MessageRepository")
Rel(message_repository, database, "Записывает клиента и сообщение", "Supabase RPC, service role")
Rel(message_handler, knowledge_answer, "Передаёт вопрос")
Rel(knowledge_answer, bot_data, "Получает тарифы и фрагменты по эмбеддингу вопроса")
Rel(bot_data, database, "Ищет по эмбеддингу и читает режим менеджера", "Supabase RPC, service role")
Rel(knowledge_answer, gemini_adapter, "Использует эмбеддинг вопроса и формирует ответ по результатам")
Rel(gemini_adapter, gemini, "Запрашивает эмбеддинг или текст ответа", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
